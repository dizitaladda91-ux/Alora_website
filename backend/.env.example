# Copy these values into backend/.env locally and configure the same values in Vercel.
# Never commit real credentials.
PORT=5000
NODE_ENV=development
MONGO_URI=replace_with_mongodb_connection_string
# Optional fallback DNS resolvers for MongoDB Atlas (`mongodb+srv`) lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace_with_a_long_random_secret
# Public store URL used in password-reset links.
CLIENT_URL=http://localhost:5500
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Affiliate/referral tracking is built into this application; no external affiliate API key is required.

# Optional order notifications and integrations
GOOGLE_SHEET_WEBHOOK_URL=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
ADMIN_PHONE=

# Product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# One-time staff bootstrap only. Run `npm run bootstrap:staff`, then remove
# the password variables from both local and deployment environments. At
# runtime, all staff login through bcrypt-hashed MongoDB user records.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEO_EMAIL=
SEO_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
PABBLY_WEBHOOK_URL=
