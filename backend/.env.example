# Copy these values into backend/.env locally and configure the same values in Vercel.
# Never commit real credentials.
PORT=5000
MONGO_URI=replace_with_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5500
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Affiliate/referral service
AFFILIATE_API_URL=https://aloraaffilation.onrender.com
STOREFRONT_API_KEY=replace_with_storefront_server_key

# Optional order notifications and integrations
GOOGLE_SHEET_WEBHOOK_URL=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
ADMIN_PHONE=

# Product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Application/admin configuration (fill in if those features are enabled)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEO_EMAIL=
SEO_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
PABBLY_WEBHOOK_URL=
