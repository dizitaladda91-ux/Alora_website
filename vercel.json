{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/backend/uploads/$1"
    },
    {
      "source": "/post/:slug*",
      "destination": "/frontend/post.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/frontend/post.html"
    },
    {
      "source": "/Blog",
      "destination": "/frontend/Blog.html"
    },
    {
      "source": "/blog",
      "destination": "/frontend/Blog.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}