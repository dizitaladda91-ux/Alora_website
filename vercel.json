{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/backend/uploads/$1"
    },
    {
      "source": "/post/:slug",
      "destination": "/frontend/post.html?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}