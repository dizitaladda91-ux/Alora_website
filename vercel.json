{
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/backend/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/backend/uploads/:path*"
    },
    {
      "source": "/post/:path*",
      "destination": "/frontend/post.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}