{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/backend/uploads/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/frontend/post.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/frontend/post.html"
    },
    {
      "source": "/blog",
      "destination": "/frontend/Blog.html"
    },
    {
      "source": "/Blog",
      "destination": "/frontend/Blog.html"
    },
    {
      "source": "/post",
      "destination": "/frontend/post.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}